  <Source dwd:design-time-name="5a8ba120-37b3-4b00-81b8-6c8538980c38">
    <DataSourceViewID>Football DWH</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="98e4d9e9-86ba-4d79-8291-95333e4ac7ee">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
Cube Hiệu suất đội bóng (Phần 1) – fact Trận đấu theo đội (fact_team_match). Trả lời: bảng xếp hạng cuối mùa, CLB thắng nhiều nhất, hiệu suất tấn công / phòng ngự, lợi thế sân nhà theo giải, phong độ qua các mùa, HLV có tỉ lệ thắng cao nhất, thành tích trước đối thủ. Hỗ trợ đánh giá thành tích đội bóng, quyết định giữ hay thay HLV và đặt mục tiêu điểm số.
*/
CALCULATE;

/* ===== Phần 1: Hiệu suất đội bóng và HLV ===== */

/* Tỉ lệ thắng = Thắng / Số trận */
CREATE MEMBER CURRENTCUBE.[Measures].[Tỉ lệ thắng] AS
    IIF([Measures].[Số trận] = 0, NULL, [Measures].[Thắng] / [Measures].[Số trận]),
    FORMAT_STRING = "0.0%", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Trận đấu đội';

/* Bàn thắng mỗi trận = Bàn thắng / Số trận */
CREATE MEMBER CURRENTCUBE.[Measures].[Bàn thắng mỗi trận] AS
    IIF([Measures].[Số trận] = 0, NULL, [Measures].[Bàn thắng] / [Measures].[Số trận]),
    FORMAT_STRING = "0.00", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Trận đấu đội';

/* Tỉ lệ thắng sân nhà = Thắng sân nhà / Số trận sân nhà */
CREATE MEMBER CURRENTCUBE.[Measures].[Tỉ lệ thắng sân nhà] AS
    IIF([Measures].[Số trận sân nhà] = 0, NULL, [Measures].[Thắng sân nhà] / [Measures].[Số trận sân nhà]),
    FORMAT_STRING = "0.0%", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Trận đấu đội';
</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="fa1de93f-b288-484d-82ff-51ffe876e525">
      <ID>KPI</ID>
      <Name>Tỉ lệ thắng của HLV</Name>
      <Description>Tỉ lệ thắng của HLV, mục tiêu ≥ 50% (vàng từ 40%), mũi tên so với mùa trước</Description>
      <AssociatedMeasureGroupID>Fact Team Match</AssociatedMeasureGroupID>
      <Value>[Measures].[Tỉ lệ thắng]</Value>
      <Goal>0.5</Goal>
      <Status>Case
  When [Measures].[Tỉ lệ thắng] &gt;= 0.5 Then 1
  When [Measures].[Tỉ lệ thắng] &gt;= 0.4 Then 0
  Else -1
End</Status>
      <Trend>CASE WHEN [Mùa giải].[Mùa giải].CurrentMember.Level.Ordinal = 0 THEN 0 WHEN ISEMPTY(([Measures].[Tỉ lệ thắng], [Mùa giải].[Mùa giải].CurrentMember.PrevMember)) THEN 0 WHEN [Measures].[Tỉ lệ thắng] &gt; ([Measures].[Tỉ lệ thắng], [Mùa giải].[Mùa giải].CurrentMember.PrevMember) THEN 1 WHEN [Measures].[Tỉ lệ thắng] &lt; ([Measures].[Tỉ lệ thắng], [Mùa giải].[Mùa giải].CurrentMember.PrevMember) THEN -1 ELSE 0 END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Shapes</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>