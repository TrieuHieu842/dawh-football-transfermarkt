  <MdxScripts>
    <MdxScript dwd:design-time-name="b0330b68-c477-4383-ae6c-118894314343">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[Tỉ lệ thắng]
 AS [Measures].[Thắng] / [Measures].[Số trận], 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Trận đấu'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Bàn thắng mỗi trận]
 AS [Measures].[Bàn thắng] / [Measures].[Số trận], 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Trận đấu'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Tỉ lệ thắng sân nhà]
 AS [Measures].[Thắng sân nhà] / [Measures].[Số trận sân nhà], 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Trận đấu'  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="2ae1e53d-59fe-457e-9d1f-35c47cb61984">
      <ID>KPI</ID>
      <Name>KPI Tỉ lệ thắng HLV</Name>
      <AssociatedMeasureGroupID>Fact Team Match</AssociatedMeasureGroupID>
      <Value>[Measures].[Tỉ lệ thắng]</Value>
      <Goal>0.5</Goal>
      <Status>Case
  When [Measures].[Tỉ lệ thắng] &gt;= 0.5 Then 1
  When [Measures].[Tỉ lệ thắng] &gt;= 0.4 Then 0
  Else -1
End</Status>
      <Trend>Case
  When [Measures].[Tỉ lệ thắng] &gt; ([Measures].[Tỉ lệ thắng], [Mùa giải].[Mùa giải].PrevMember) Then 1
  When [Measures].[Tỉ lệ thắng] = ([Measures].[Tỉ lệ thắng], [Mùa giải].[Mùa giải].PrevMember) Then 0
  Else -1
End</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Shapes</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>