  <Source dwd:design-time-name="927ce46a-5811-45e1-b171-42a50461cad8">
    <DataSourceViewID>Football DWH</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="57b2075b-b391-4b33-848b-11b14751def3">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
Cube Hiệu suất cầu thủ (Phần 2) – fact Lượt ra sân (fact_player_appearance).
Trả lời: vua phá lưới, vua kiến tạo, bàn mỗi 90 phút, cầu thủ ra sân nhiều nhất, đóng góp bàn thắng theo vị trí x giải, trọng tài khắt khe nhất, cầu thủ trẻ thi đấu nhiều phút.
Hỗ trợ tuyển trạch, đánh giá phong độ và gia hạn hợp đồng cầu thủ.
*/
CALCULATE;

/* ===== Phần 2: Hiệu suất cầu thủ ===== */

/* Q1 &amp; Q2. Bàn mỗi 90 phút = (Bàn thắng * 90) / Số phút */
CREATE MEMBER CURRENTCUBE.[Measures].[Bàn mỗi 90 phút] AS
    IIF([Measures].[Số phút] = 0, NULL, ([Measures].[Bàn thắng cầu thủ] * 90) / [Measures].[Số phút]),
    FORMAT_STRING = "0.00", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Lượt ra sân';

/* Bàn và kiến tạo mỗi 90 phút */
CREATE MEMBER CURRENTCUBE.[Measures].[Bàn và kiến tạo mỗi 90 phút] AS
    IIF([Measures].[Số phút] = 0, NULL, (([Measures].[Bàn thắng cầu thủ] + [Measures].[Kiến tạo]) * 90) / [Measures].[Số phút]),
    FORMAT_STRING = "0.00", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Lượt ra sân';

/* Q5. Thẻ phạt mỗi trận = (Thẻ vàng + Thẻ đỏ) / Số trận có ra sân */
CREATE MEMBER CURRENTCUBE.[Measures].[Thẻ phạt mỗi trận] AS
    IIF([Measures].[Số trận có ra sân] = 0, NULL, ([Measures].[Thẻ vàng] + [Measures].[Thẻ đỏ]) / [Measures].[Số trận có ra sân]),
    FORMAT_STRING = "0.00", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Lượt ra sân';
</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="61bffc72-612d-418c-b835-abbec6c43064">
      <ID>Ban moi 90 phut cua tien dao</ID>
      <Name>Bàn mỗi 90 phút của tiền đạo</Name>
      <Description>Hiệu suất ghi bàn mỗi 90 phút của tiền đạo, mục tiêu tối thiểu 0.5 bàn/90 phút</Description>
      <AssociatedMeasureGroupID>Fact Player Appearance</AssociatedMeasureGroupID>
      <Value>[Measures].[Bàn mỗi 90 phút]</Value>
      <Goal>0.5</Goal>
      <Status>CASE WHEN KPIValue("Bàn mỗi 90 phút của tiền đạo") &gt;= KPIGoal("Bàn mỗi 90 phút của tiền đạo") THEN 1 WHEN KPIValue("Bàn mỗi 90 phút của tiền đạo") &gt;= 0.3 THEN 0 ELSE -1 END</Status>
      <Trend>CASE WHEN [Mùa giải].[Mùa giải].CurrentMember.Level.Ordinal = 0 THEN 0 WHEN ISEMPTY(([Measures].[Bàn mỗi 90 phút], [Mùa giải].[Mùa giải].CurrentMember.PrevMember)) THEN 0 WHEN [Measures].[Bàn mỗi 90 phút] &gt; ([Measures].[Bàn mỗi 90 phút], [Mùa giải].[Mùa giải].CurrentMember.PrevMember) THEN 1 WHEN [Measures].[Bàn mỗi 90 phút] &lt; ([Measures].[Bàn mỗi 90 phút], [Mùa giải].[Mùa giải].CurrentMember.PrevMember) THEN -1 ELSE 0 END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light - Single</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>