<?xml version="1.0" encoding="utf-8"?>
<Cube xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ddl2="http://schemas.microsoft.com/analysisservices/2003/engine/2" xmlns:ddl2_2="http://schemas.microsoft.com/analysisservices/2003/engine/2/2" xmlns:ddl100_100="http://schemas.microsoft.com/analysisservices/2008/engine/100/100" xmlns:ddl200="http://schemas.microsoft.com/analysisservices/2010/engine/200" xmlns:ddl200_200="http://schemas.microsoft.com/analysisservices/2010/engine/200/200" xmlns:ddl300="http://schemas.microsoft.com/analysisservices/2011/engine/300" xmlns:ddl300_300="http://schemas.microsoft.com/analysisservices/2011/engine/300/300" xmlns:ddl400="http://schemas.microsoft.com/analysisservices/2012/engine/400" xmlns:ddl400_400="http://schemas.microsoft.com/analysisservices/2012/engine/400/400" xmlns:ddl500="http://schemas.microsoft.com/analysisservices/2013/engine/500" xmlns:ddl500_500="http://schemas.microsoft.com/analysisservices/2013/engine/500/500" xmlns:dwd="http://schemas.microsoft.com/DataWarehouse/Designer/1.0" dwd:design-time-name="38be9261-90c2-4e2f-ba42-d5110c36d16b" xmlns="http://schemas.microsoft.com/analysisservices/2003/engine"><ID>Thi truong cau thu</ID><Name>Thị trường cầu thủ</Name><Description>Cube Thị trường cầu thủ (Phần 3) – fact Định giá và Chuyển nhượng. Trả lời: giá trị đội hình mỗi CLB, cầu thủ/CLB tăng giá mạnh nhất, độ tuổi đỉnh giá trị theo vị trí, CLB chi tiêu ròng nhiều nhất mỗi mùa, CLB mua đắt hay rẻ so với giá trị thị trường, tỉ lệ thương vụ miễn phí / cho mượn / đội trẻ. Hỗ trợ quản lý tài sản cầu thủ, ngân sách chuyển nhượng và thời điểm mua bán.</Description><CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp><LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate><LastProcessed>0001-01-01T00:00:00Z</LastProcessed><State>Unprocessed</State><Dimensions><Dimension dwd:design-time-name="541e3bd1-f3a7-4804-9dd4-335d87914253"><ID>Ngay</ID><Name>Ngày</Name><DimensionID>Ngay</DimensionID></Dimension><Dimension dwd:design-time-name="a5bd7faf-3bfc-46ab-8d13-d293708cf7d4"><ID>Mua giai</ID><Name>Mùa giải</Name><DimensionID>Mua giai</DimensionID></Dimension><Dimension dwd:design-time-name="53b3831a-7292-4817-af97-409febe427ae"><ID>Giai dau</ID><Name>Giải đấu</Name><DimensionID>Giai dau</DimensionID></Dimension><Dimension dwd:design-time-name="4e52da2a-0b6b-43ee-89f2-1492edeaa432"><ID>Cau thu</ID><Name>Cầu thủ</Name><DimensionID>Cau thu</DimensionID></Dimension><Dimension dwd:design-time-name="e700a5d3-35e8-49f4-a6c3-ceca2f2a15a4"><ID>Tuoi</ID><Name>Tuổi</Name><DimensionID>Tuoi</DimensionID></Dimension><Dimension dwd:design-time-name="a90319d6-cab7-4929-8c9f-18525a36bc96"><ID>CLB</ID><Name>CLB</Name><DimensionID>CLB</DimensionID></Dimension><Dimension dwd:design-time-name="504144e8-7442-4c92-8382-6f57b10ba09b"><ID>CLB di</ID><Name>CLB đi</Name><DimensionID>CLB</DimensionID></Dimension><Dimension dwd:design-time-name="e660d880-7c29-45b1-886e-dfb543c5efd6"><ID>CLB den</ID><Name>CLB đến</Name><DimensionID>CLB</DimensionID></Dimension><Dimension dwd:design-time-name="cca53e92-8a6a-4ff2-82e9-99c36ad905eb"><ID>Loai chuyen nhuong</ID><Name>Loại chuyển nhượng</Name><DimensionID>Loai chuyen nhuong</DimensionID></Dimension></Dimensions><MdxScripts><MdxScript dwd:design-time-name="211cd5ad-ec51-414f-a929-0cc0d02059c7"><ID>MdxScript</ID><Name>MdxScript</Name><Commands><Command><Text>/*
Cube Thị trường cầu thủ (Phần 3) – fact Định giá và Chuyển nhượng. Trả lời: giá trị đội hình mỗi CLB, cầu thủ/CLB tăng giá mạnh nhất, độ tuổi đỉnh giá trị theo vị trí, CLB chi tiêu ròng nhiều nhất mỗi mùa, CLB mua đắt hay rẻ so với giá trị thị trường, tỉ lệ thương vụ miễn phí / cho mượn / đội trẻ. Hỗ trợ quản lý tài sản cầu thủ, ngân sách chuyển nhượng và thời điểm mua bán.
*/
CALCULATE;

/* ===== Phần 3: Giá trị và chuyển nhượng ===== */

/* Q1. Giá trị đội hình: cộng giá trị lần định giá CUỐI CÙNG trong kỳ của từng cầu thủ
   (Giá trị thị trường là LastNonEmpty nên phải lặp qua từng cầu thủ rồi mới cộng). */
CREATE MEMBER CURRENTCUBE.[Measures].[Giá trị đội hình] AS
    SUM(NONEMPTY(EXISTING [Cầu thủ].[Cầu thủ].[Cầu thủ].MEMBERS, [Measures].[Số lần định giá]),
        [Measures].[Giá trị thị trường]),
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Định giá';

/* Q3. Giá trị trung bình mỗi lần định giá và tuổi trung bình lúc định giá */
CREATE MEMBER CURRENTCUBE.[Measures].[Giá trị trung bình] AS
    IIF([Measures].[Số lần định giá] = 0, NULL, [Measures].[Tổng giá trị định giá] / [Measures].[Số lần định giá]),
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Định giá';

CREATE MEMBER CURRENTCUBE.[Measures].[Tuổi trung bình lúc định giá] AS
    IIF([Measures].[Số lần có tuổi] = 0, NULL, [Measures].[Tổng tuổi định giá] / [Measures].[Số lần có tuổi]),
    FORMAT_STRING = "0.0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Định giá';

/* Q4. Chi mua, Thu bán, Chi tiêu ròng: xem với [CLB đến] trên trục.
   Thu bán = phí các thương vụ mà CLB đó là CLB ĐI -&gt; LINKMEMBER chuyển CLB đến sang CLB đi. */
CREATE MEMBER CURRENTCUBE.[Measures].[Chi mua] AS
    [Measures].[Phí chuyển nhượng],
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

CREATE MEMBER CURRENTCUBE.[Measures].[Thu bán] AS
    ([Measures].[Phí chuyển nhượng],
     LINKMEMBER([CLB đến].[CLB].CurrentMember, [CLB đi].[CLB]),
     [CLB đến].[CLB].[All]),
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

CREATE MEMBER CURRENTCUBE.[Measures].[Chi tiêu ròng] AS
    [Measures].[Chi mua] - [Measures].[Thu bán],
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

/* Ngân sách giả định cho KPI (100 triệu € mỗi CLB mỗi mùa) */
CREATE MEMBER CURRENTCUBE.[Measures].[Ngân sách chuyển nhượng] AS
    100000000,
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

/* Q5. Phí trung bình (chỉ thương vụ công bố phí) và phí chênh trung bình so với giá trị thị trường */
CREATE MEMBER CURRENTCUBE.[Measures].[Phí trung bình] AS
    IIF([Measures].[Số thương vụ công bố phí] = 0, NULL, [Measures].[Phí chuyển nhượng] / [Measures].[Số thương vụ công bố phí]),
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

CREATE MEMBER CURRENTCUBE.[Measures].[Phí chênh trung bình] AS
    IIF([Measures].[Số thương vụ có phí chênh] = 0, NULL, [Measures].[Phí chênh] / [Measures].[Số thương vụ có phí chênh]),
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

/* Q6. Tỉ lệ thương vụ miễn phí / cho mượn, tỉ lệ thương vụ đội trẻ, tuổi trung bình cầu thủ chuyên nghiệp được mua */
CREATE MEMBER CURRENTCUBE.[Measures].[Tỉ lệ miễn phí] AS
    IIF([Measures].[Số thương vụ] = 0, NULL, [Measures].[Số thương vụ miễn phí] / [Measures].[Số thương vụ]),
    FORMAT_STRING = "0.0%", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

CREATE MEMBER CURRENTCUBE.[Measures].[Tỉ lệ đội trẻ] AS
    IIF([Measures].[Số thương vụ đội trẻ] + [Measures].[Số thương vụ chuyên nghiệp] = 0, NULL,
        [Measures].[Số thương vụ đội trẻ] / ([Measures].[Số thương vụ đội trẻ] + [Measures].[Số thương vụ chuyên nghiệp])),
    FORMAT_STRING = "0.0%", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

CREATE MEMBER CURRENTCUBE.[Measures].[Tuổi trung bình cầu thủ chuyên nghiệp] AS
    IIF([Measures].[Số thương vụ chuyên nghiệp] = 0, NULL, [Measures].[Tổng tuổi chuyên nghiệp] / [Measures].[Số thương vụ chuyên nghiệp]),
    FORMAT_STRING = "0.0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';
</Text></Command></Commands></MdxScript></MdxScripts><Kpis><Kpi dwd:design-time-name="07feeeca-80ba-491c-b71a-86531650bb5f"><ID>Chi tieu rong so voi ngan sach</ID><Name>Chi tiêu ròng so với ngân sách</Name><Description>Chi tiêu ròng mỗi mùa của CLB (xem theo CLB đến) so với ngân sách giả định 100 triệu €</Description><AssociatedMeasureGroupID>Fact Transfer</AssociatedMeasureGroupID><Value>[Measures].[Chi tiêu ròng]</Value><Goal>[Measures].[Ngân sách chuyển nhượng]</Goal><Status>CASE WHEN KPIValue("Chi tiêu ròng so với ngân sách") &lt;= KPIGoal("Chi tiêu ròng so với ngân sách") THEN 1 WHEN KPIValue("Chi tiêu ròng so với ngân sách") &lt;= 1.5 * KPIGoal("Chi tiêu ròng so với ngân sách") THEN 0 ELSE -1 END</Status><StatusGraphic>Traffic Light - Single</StatusGraphic><Trend>CASE WHEN [Mùa giải].[Mùa giải].CurrentMember.Level.Ordinal = 0 THEN 0 WHEN ISEMPTY(([Measures].[Chi tiêu ròng], [Mùa giải].[Mùa giải].CurrentMember.PrevMember)) THEN 0 WHEN [Measures].[Chi tiêu ròng] &gt; ([Measures].[Chi tiêu ròng], [Mùa giải].[Mùa giải].CurrentMember.PrevMember) THEN 1 WHEN [Measures].[Chi tiêu ròng] &lt; ([Measures].[Chi tiêu ròng], [Mùa giải].[Mùa giải].CurrentMember.PrevMember) THEN -1 ELSE 0 END</Trend><TrendGraphic>Standard Arrow</TrendGraphic></Kpi></Kpis><MeasureGroups><MeasureGroup dwd:design-time-name="c8d5485f-88d3-42db-8ea2-ea952e23f073"><ID>Fact Player Valuation</ID><Name>Định giá</Name><CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp><LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate><LastProcessed>0001-01-01T00:00:00Z</LastProcessed><State>Unprocessed</State><Measures><Measure dwd:design-time-name="b4771cb2-5b30-4227-baa3-c16e4d22dca9"><ID>Gia tri thi truong</ID><Name>Giá trị thị trường</Name><AggregateFunction>LastNonEmpty</AggregateFunction><DataType>BigInt</DataType><Source dwd:design-time-name="2df53d4b-657d-40db-acf2-8f4713652945"><DataType>BigInt</DataType><Source xsi:type="ColumnBinding" dwd:design-time-name="4594d84f-2420-4143-b2f3-b57553183f0e"><TableID>dbo_fact_player_valuation</TableID><ColumnID>market_value_eur</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure dwd:design-time-name="705fef9e-13a6-4fce-b5b3-58141d86554c"><ID>Tong gia tri dinh gia</ID><Name>Tổng giá trị định giá</Name><AggregateFunction>Sum</AggregateFunction><DataType>BigInt</DataType><Source dwd:design-time-name="2ee08cd0-b9e9-43b0-a97a-56285639af42"><DataType>BigInt</DataType><Source xsi:type="ColumnBinding" dwd:design-time-name="38c4e143-47e5-4408-8467-94206759a5bc"><TableID>dbo_fact_player_valuation</TableID><ColumnID>market_value_eur</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure dwd:design-time-name="785d0e90-6745-4b4e-a7cf-35902ad4b0a2"><ID>Muc tang gia</ID><Name>Mức tăng giá</Name><AggregateFunction>Sum</AggregateFunction><DataType>BigInt</DataType><Source dwd:design-time-name="b6eba7db-f0a8-48f5-ae77-afbf6a5b8ceb"><DataType>BigInt</DataType><Source xsi:type="ColumnBinding" dwd:design-time-name="def4b308-a68e-466e-83bc-bb876c823261"><TableID>dbo_fact_player_valuation</TableID><ColumnID>value_change_eur</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure dwd:design-time-name="9a22c765-7f9c-4638-a723-c1c6a084a6c6"><ID>Tong tuoi dinh gia</ID><Name>Tổng tuổi định giá</Name><AggregateFunction>Sum</AggregateFunction><DataType>BigInt</DataType><Source dwd:design-time-name="7cef5f33-00cb-426d-aecd-bf0e96f39c24"><DataType>BigInt</DataType><Source xsi:type="ColumnBinding" dwd:design-time-name="537848ca-0220-4a78-9c14-1bba89ae90a2"><TableID>dbo_fact_player_valuation</TableID><ColumnID>age_at_valuation</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure dwd:design-time-name="b4ad887c-c41c-4b7e-ac76-0f119287a40e"><ID>So lan co tuoi</ID><Name>Số lần có tuổi</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source dwd:design-time-name="a7cd536e-c1bf-4e40-92d6-a56c7267c697"><DataType>Integer</DataType><Source xsi:type="ColumnBinding" dwd:design-time-name="593991dd-0237-4f91-b82d-02316608a224"><TableID>dbo_fact_player_valuation</TableID><ColumnID>has_age</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure dwd:design-time-name="4d04d4de-1d67-4970-add5-3ce033f34c13"><ID>So lan dinh gia</ID><Name>Số lần định giá</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source dwd:design-time-name="4d508fd7-448b-446e-b952-4bfafb874346"><DataType>Integer</DataType><Source xsi:type="ColumnBinding" dwd:design-time-name="016868f2-395e-4b9f-b802-a34fede8b266"><TableID>dbo_fact_player_valuation</TableID><ColumnID>valuation_count</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure></Measures><StorageMode>Molap</StorageMode><ProcessingMode>Regular</ProcessingMode><Dimensions><Dimension xsi:type="RegularMeasureGroupDimension" dwd:design-time-name="99929ba5-1418-4767-982b-5f7e95fa7e3f"><CubeDimensionID>Ngay</CubeDimensionID><Attributes><Attribute dwd:design-time-name="bcc3492b-b9d8-4b2b-85ab-20ed591712f0"><AttributeID>Ngay</AttributeID><KeyColumns><KeyColumn dwd:design-time-name="32e25c44-f92d-4bfd-85c8-5059e9dcc505"><DataType>Integer</DataType><Source xsi:type="ColumnBinding" dwd:design-time-name="4832dcbf-9ade-4b64-95cd-1165c8c7ec03"><TableID>dbo_fact_player_valuation</TableID><ColumnID>date_key</ColumnID></Source></KeyColumn></KeyColumns><Type>Granularity</Type></Attribute></Attributes></Dimension><Dimension xsi:type="RegularMeasureGroupDimension" dwd:design-time-name="adc443b3-25a6-42cb-a94d-781a829ddcc3"><CubeDimensionID>Cau thu</CubeDimensionID><Attributes><Attribute dwd:design-time-name="59297d3c-559a-4da3-8460-a9981edc6437"><AttributeID>Cau thu</AttributeID><KeyColumns><KeyColumn dwd:design-time-name="1e023fdd-4a5e-41d4-ae34-b5f1cec06956"><DataType>Integer</DataType><Source xsi:type="ColumnBinding" dwd:design-time-name="7745bebd-5d7c-4436-949a-0a03f6c9ddc4"><TableID>dbo_fact_player_valuation</TableID