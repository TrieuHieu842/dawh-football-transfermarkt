  <MdxScripts>
    <MdxScript dwd:design-time-name="779ad69a-ee24-4e55-84e3-4191101f3343">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
Cube Thị trường cầu thủ (Phần 3) – fact Định giá và Chuyển nhượng. Trả lời: giá trị đội hình mỗi CLB, cầu thủ/CLB tăng giá mạnh nhất, độ tuổi đỉnh giá trị theo vị trí, CLB chi tiêu ròng nhiều nhất mỗi mùa, CLB mua đắt hay rẻ so với giá trị thị trường, tỉ lệ thương vụ miễn phí / cho mượn / đội trẻ. Hỗ trợ quản lý tài sản cầu thủ, ngân sách chuyển nhượng và thời điểm mua bán.
*/
CALCULATE;

/* ===== Phần 3: Giá trị và chuyển nhượng ===== */

/* Q1. Giá trị đội hình: cộng giá trị lần định giá CUỐI CÙNG trong kỳ của từng cầu thủ
   (Giá trị thị trường là LastNonEmpty nên phải lặp qua từng cầu thủ rồi mới cộng). */
CREATE MEMBER CURRENTCUBE.[Measures].[Giá trị đội hình] AS
    SUM(NONEMPTY(EXISTING [Cầu thủ].[Cầu thủ].[Cầu thủ].MEMBERS, [Measures].[Số lần định giá]),
        [Measures].[Giá trị thị trường]),
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Định giá';

/* Q3. Giá trị trung bình mỗi lần định giá và tuổi trung bình lúc định giá */
CREATE MEMBER CURRENTCUBE.[Measures].[Giá trị trung bình] AS
    IIF([Measures].[Số lần định giá] = 0, NULL, [Measures].[Tổng giá trị định giá] / [Measures].[Số lần định giá]),
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Định giá';

CREATE MEMBER CURRENTCUBE.[Measures].[Tuổi trung bình lúc định giá] AS
    IIF([Measures].[Số lần có tuổi] = 0, NULL, [Measures].[Tổng tuổi định giá] / [Measures].[Số lần có tuổi]),
    FORMAT_STRING = "0.0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Định giá';

/* Q4. Chi mua, Thu bán, Chi tiêu ròng: xem với [CLB đến] trên trục.
   Thu bán = phí các thương vụ mà CLB đó là CLB ĐI -&gt; LINKMEMBER chuyển CLB đến sang CLB đi. */
CREATE MEMBER CURRENTCUBE.[Measures].[Chi mua] AS
    [Measures].[Phí chuyển nhượng],
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

CREATE MEMBER CURRENTCUBE.[Measures].[Thu bán] AS
    ([Measures].[Phí chuyển nhượng],
     LINKMEMBER([CLB đến].[CLB].CurrentMember, [CLB đi].[CLB]),
     [CLB đến].[CLB].[All]),
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

CREATE MEMBER CURRENTCUBE.[Measures].[Chi tiêu ròng] AS
    [Measures].[Chi mua] - [Measures].[Thu bán],
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

/* Ngân sách giả định cho KPI (100 triệu € mỗi CLB mỗi mùa) */
CREATE MEMBER CURRENTCUBE.[Measures].[Ngân sách chuyển nhượng] AS
    100000000,
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

/* Q5. Phí trung bình (chỉ thương vụ công bố phí) và phí chênh trung bình so với giá trị thị trường */
CREATE MEMBER CURRENTCUBE.[Measures].[Phí trung bình] AS
    IIF([Measures].[Số thương vụ công bố phí] = 0, NULL, [Measures].[Phí chuyển nhượng] / [Measures].[Số thương vụ công bố phí]),
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

CREATE MEMBER CURRENTCUBE.[Measures].[Phí chênh trung bình] AS
    IIF([Measures].[Số thương vụ có phí chênh] = 0, NULL, [Measures].[Phí chênh] / [Measures].[Số thương vụ có phí chênh]),
    FORMAT_STRING = "#,##0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

/* Q6. Tỉ lệ thương vụ miễn phí / cho mượn, tỉ lệ thương vụ đội trẻ, tuổi trung bình cầu thủ chuyên nghiệp được mua */
CREATE MEMBER CURRENTCUBE.[Measures].[Tỉ lệ miễn phí] AS
    IIF([Measures].[Số thương vụ] = 0, NULL, [Measures].[Số thương vụ miễn phí] / [Measures].[Số thương vụ]),
    FORMAT_STRING = "0.0%", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

CREATE MEMBER CURRENTCUBE.[Measures].[Tỉ lệ đội trẻ] AS
    IIF([Measures].[Số thương vụ đội trẻ] + [Measures].[Số thương vụ chuyên nghiệp] = 0, NULL,
        [Measures].[Số thương vụ đội trẻ] / ([Measures].[Số thương vụ đội trẻ] + [Measures].[Số thương vụ chuyên nghiệp])),
    FORMAT_STRING = "0.0%", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';

CREATE MEMBER CURRENTCUBE.[Measures].[Tuổi trung bình cầu thủ chuyên nghiệp] AS
    IIF([Measures].[Số thương vụ chuyên nghiệp] = 0, NULL, [Measures].[Tổng tuổi chuyên nghiệp] / [Measures].[Số thương vụ chuyên nghiệp]),
    FORMAT_STRING = "0.0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Chuyển nhượng';
</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="b1660d15-5ac9-4513-8b44-b74b57267a7d">
      <ID>Chi tieu rong so voi ngan sach</ID>
      <Name>Chi tiêu ròng so với ngân sách</Name>
      <Description>Chi tiêu ròng mỗi mùa của CLB (xem theo CLB đến) so với ngân sách giả định 100 triệu €</Description>
      <AssociatedMeasureGroupID>Fact Transfer</AssociatedMeasureGroupID>
      <Value>[Measures].[Chi tiêu ròng]</Value>
      <Goal>[Measures].[Ngân sách chuyển nhượng]</Goal>
      <Status>CASE WHEN KPIValue("Chi tiêu ròng so với ngân sách") &lt;= KPIGoal("Chi tiêu ròng so với ngân sách") THEN 1 WHEN KPIValue("Chi tiêu ròng so với ngân sách") &lt;= 1.5 * KPIGoal("Chi tiêu ròng so với ngân sách") THEN 0 ELSE -1 END</Status>
      <Trend>CASE WHEN [Mùa giải].[Mùa giải].CurrentMember.Level.Ordinal = 0 THEN 0 WHEN ISEMPTY(([Measures].[Chi tiêu ròng], [Mùa giải].[Mùa giải].CurrentMember.PrevMember)) THEN 0 WHEN [Measures].[Chi tiêu ròng] &gt; ([Measures].[Chi tiêu ròng], [Mùa giải].[Mùa giải].CurrentMember.PrevMember) THEN 1 WHEN [Measures].[Chi tiêu ròng] &lt; ([Measures].[Chi tiêu ròng], [Mùa giải].[Mùa giải].CurrentMember.PrevMember) THEN -1 ELSE 0 END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light - Single</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>