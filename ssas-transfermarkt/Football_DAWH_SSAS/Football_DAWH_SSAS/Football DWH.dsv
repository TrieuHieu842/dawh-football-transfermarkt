            <xs:element name="dim_age" msprop:QueryBuilder="GenericQueryBuilder" msprop:IsLogical="True" msprop:design-time-name="8b28912f-ac57-4f08-8175-bf1f98538120" msprop:QueryDefinition="SELECT a.age_key,&#xA;       CASE WHEN a.age_key = 0 THEN N'Không rõ' ELSE CAST(a.age_key AS nvarchar(3)) END AS age_label,&#xA;       CASE WHEN a.age_key = 0 THEN N'Không rõ' WHEN a.age_key &lt; 18 THEN N'Dưới 18' WHEN a.age_key &lt;= 21 THEN N'18-21'&#xA;            WHEN a.age_key &lt;= 24 THEN N'22-24' WHEN a.age_key &lt;= 28 THEN N'25-28' WHEN a.age_key &lt;= 31 THEN N'29-31' ELSE N'32+' END AS age_group,&#xA;       CASE WHEN a.age_key = 0 THEN 9 WHEN a.age_key &lt; 18 THEN 1 WHEN a.age_key &lt;= 21 THEN 2 WHEN a.age_key &lt;= 24 THEN 3&#xA;            WHEN a.age_key &lt;= 28 THEN 4 WHEN a.age_key &lt;= 31 THEN 5 ELSE 6 END AS age_group_order&#xA;FROM (SELECT ISNULL(CAST(age_at_valuation AS int), 0) AS age_key FROM dbo.fact_player_valuation&#xA;      UNION SELECT ISNULL(CAST(age_at_transfer AS int), 0) FROM dbo.fact_transfer) AS a" msprop:FriendlyName="dim_age" msprop:TableType="View" msprop:DbTableName="dim_age" msprop:Description="Tuổi lúc định giá / chuyển nhượng (0 = không rõ) và nhóm tuổi">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="age_key" msprop:FriendlyName="age_key" msprop:DbColumnName="age_key" msprop:design-time-name="829aa5b8-9fee-4da5-87ec-9d35ffebc433" type="xs:int" />
                  <xs:element name="age_label" msprop:FriendlyName="age_label" msprop:DbColumnName="age_label" msprop:design-time-name="70348a80-4996-4098-8b34-3333052b194e" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="20" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="age_group" msprop:FriendlyName="age_group" msprop:DbColumnName="age_group" msprop:design-time-name="1f13ebfb-4fcf-4052-9247-c68ad0840ef8" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="20" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="age_group_order" msprop:FriendlyName="age_group_order" msprop:DbColumnName="age_group_order" msprop:design-time-name="9acc37f5-ddfb-4e18-b6e2-e3fee6e88979" type="xs:int" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:choice>
