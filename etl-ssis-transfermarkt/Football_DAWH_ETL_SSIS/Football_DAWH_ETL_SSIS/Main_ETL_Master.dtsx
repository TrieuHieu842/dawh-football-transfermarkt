                              name="FriendlyExpression">ISNULL(date_of_birth) || ISNULL(c_transfer_date) ? NULL(DT_UI1) : (DT_UI1)((DATEDIFF("yyyy",date_of_birth,c_transfer_date) - ((MONTH(c_transfer_date) * 100 + DAY(c_transfer_date)) &lt; (MONTH(date_of_birth) * 100 + DAY(date_of_birth)) ? 1 : 0)) &lt; 18 ? 1 : 0)</property>
                          </properties>
                        </outputColumn>
