                <component
                  refId="Package\Sequence Container 02 - Transform Staging Clean\DFT_stg_clean_players\SRC_stg_raw_players"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="SRC_stg_raw_players"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset">[dbo].[stg_raw_players]</property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    CAST(player_id AS NVARCHAR(50)) AS player_id,
    CAST(first_name AS NVARCHAR(100)) AS first_name,
    CAST(last_name AS NVARCHAR(100)) AS last_name,
    CAST(name AS NVARCHAR(200)) AS name,

    CAST(current_club_id AS NVARCHAR(50)) AS current_club_id,

    CAST(country_of_birth AS NVARCHAR(100)) AS country_of_birth,
    CAST(country_of_citizenship AS NVARCHAR(100)) AS country_of_citizenship,

    CAST(date_of_birth AS NVARCHAR(50)) AS date_of_birth,

    CAST(sub_position AS NVARCHAR(100)) AS sub_position,
    CAST(position AS NVARCHAR(100)) AS position,
    CAST(foot AS NVARCHAR(50)) AS foot,

