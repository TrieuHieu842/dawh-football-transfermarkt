        <DTS:Executable
          DTS:refId="Package\Container 03 - Load Facts\SQL - Set Load Window"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Ghi cửa sổ nạp từ biến LoadFrom/LoadTo vào etl_load_window; xóa reject cũ của fact"
          DTS:DTSID="{EB58195A-2BD0-4991-8558-B486F2EBD359}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL - Set Load Window"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="SqlStatementSource">"UPDATE dbo.etl_load_window SET window_from = '" + (DT_WSTR,4)YEAR(@[User::LoadFrom]) + "-" + RIGHT("0" + (DT_WSTR,2)MONTH(@[User::LoadFrom]), 2) + "-" + RIGHT("0" + (DT_WSTR,2)DAY(@[User::LoadFrom]), 2) + "', window_to = '" + (DT_WSTR,4)YEAR(@[User::LoadTo]) + "-" + RIGHT("0" + (DT_WSTR,2)MONTH(@[User::LoadTo]), 2) + "-" + RIGHT("0" + (DT_WSTR,2)DAY(@[User::LoadTo]), 2) + "' WHERE id = 1;\nDELETE FROM football_dwh_staging.dbo.etl_reject\nWHERE source_table IN (N'stg_raw_club_games', N'stg_raw_appearances', N'stg_raw_player_valuations', N'stg_raw_transfers');\nUPDATE dbo.dim_date SET is_future_date = CASE WHEN full_date &gt; CAST(GETDATE() AS DATE) THEN 1 ELSE 0 END WHERE date_key &lt;&gt; -1;"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CCA0D3D2-D93F-4674-A6B8-B31668730BC4}"
              SQLTask:SqlStatementSource="UPDATE dbo.etl_load_window SET window_from = '1900-01-01', window_to = '9999-12-31' WHERE id = 1;&#xA;DELETE FROM football_dwh_staging.dbo.etl_reject&#xA;WHERE source_table IN (N'stg_raw_club_games', N'stg_raw_appearances', N'stg_raw_player_valuations', N'stg_raw_transfers');&#xA;UPDATE dbo.dim_date SET is_future_date = CASE WHEN full_date &gt; CAST(GETDATE() AS DATE) THEN 1 ELSE 0 END WHERE date_key &lt;&gt; -1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
