    <DTS:Executable
      DTS:refId="Package\03 - Làm sạch tính toán và nạp Fact"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Nạp fact từ stage theo cửa sổ LoadFrom-LoadTo, Lookup các dim, chỉ insert dòng chưa có"
      DTS:DTSID="{908F5547-2D57-48A5-AB86-2D2F0B636ACE}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="03 - Làm sạch tính toán và nạp Fact">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\03 - Làm sạch tính toán và nạp Fact\Ghi cửa sổ nạp gia tăng"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Ghi cửa sổ nạp từ biến LoadFrom/LoadTo vào etl_load_window; xóa reject cũ của fact"
          DTS:DTSID="{EB58195A-2BD0-4991-8558-B486F2EBD359}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Ghi cửa sổ nạp gia tăng"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="SqlStatementSource">"UPDATE dbo.etl_load_window SET window_from = '" + (DT_WSTR,4)YEAR(@[User::LoadFrom]) + "-" + RIGHT("0" + (DT_WSTR,2)MONTH(@[User::LoadFrom]), 2) + "-" + RIGHT("0" + (DT_WSTR,2)DAY(@[User::LoadFrom]), 2) + "', window_to = '" + (DT_WSTR,4)YEAR(@[User::LoadTo]) + "-" + RIGHT("0" + (DT_WSTR,2)MONTH(@[User::LoadTo]), 2) + "-" + RIGHT("0" + (DT_WSTR,2)DAY(@[User::LoadTo]), 2) + "' WHERE id = 1;\nDELETE FROM football_dwh_staging.dbo.etl_reject\nWHERE source_table IN (N'stg_raw_club_games', N'stg_raw_appearances', N'stg_raw_player_valuations', N'stg_raw_transfers');\n"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CCA0D3D2-D93F-4674-A6B8-B31668730BC4}"
              SQLTask:SqlStatementSource="UPDATE dbo.etl_load_window SET window_from = '1900-01-01', window_to = '9999-12-31' WHERE id = 1;&#xA;DELETE FROM football_dwh_staging.dbo.etl_reject&#xA;WHERE source_table IN (N'stg_raw_club_games', N'stg_raw_appearances', N'stg_raw_player_valuations', N'stg_raw_transfers');&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\03 - Làm sạch tính toán và nạp Fact\Ghi nhật ký bắt đầu lần chạy"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Thêm 1 dòng vào etl_batch: mã lần chạy, cửa sổ nạp, giờ bắt đầu, tổng số dòng fact trước khi nạp; lần chạy trước còn RUNNING (bị dừng giữa chừng) đánh dấu FAILED"
          DTS:DTSID="{AC5AD3C0-8406-4E7A-83BA-7E65A37F4A4E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Ghi nhật ký bắt đầu lần chạy"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="SqlStatementSource">"UPDATE dbo.etl_batch SET status = N'FAILED' WHERE status = N'RUNNING';
INSERT INTO dbo.etl_batch (batch_id, window_from, window_to, started_at, status, fact_rows_before)
VALUES (N'" + @[User::BatchID] + "', '" + (DT_WSTR,4)YEAR(@[User::LoadFrom]) + "-" + RIGHT("0" + (DT_WSTR,2)MONTH(@[User::LoadFrom]), 2) + "-" + RIGHT("0" + (DT_WSTR,2)DAY(@[User::LoadFrom]), 2) + "', '" + (DT_WSTR,4)YEAR(@[User::LoadTo]) + "-" + RIGHT("0" + (DT_WSTR,2)MONTH(@[User::LoadTo]), 2) + "-" + RIGHT("0" + (DT_WSTR,2)DAY(@[User::LoadTo]), 2) + "', '" + (DT_WSTR,4)YEAR(@[System::StartTime]) + "-" + RIGHT("0" + (DT_WSTR,2)MONTH(@[System::StartTime]), 2) + "-" + RIGHT("0" + (DT_WSTR,2)DAY(@[System::StartTime]), 2) + " " + RIGHT("0" + (DT_WSTR,2)DATEPART("hh",@[System::StartTime]), 2) + ":" + RIGHT("0" + (DT_WSTR,2)DATEPART("mi",@[System::StartTime]), 2) + ":" + RIGHT("0" + (DT_WSTR,2)DATEPART("ss",@[System::StartTime]), 2) + "', N'RUNNING',
        (SELECT COUNT(*) FROM dbo.fact_team_match) + (SELECT COUNT(*) FROM dbo.fact_player_appearance) + (SELECT COUNT(*) FROM dbo.fact_player_valuation) + (SELECT COUNT(*) FROM dbo.fact_transfer));
"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{CCA0D3D2-D93F-4674-A6B8-B31668730BC4}"
