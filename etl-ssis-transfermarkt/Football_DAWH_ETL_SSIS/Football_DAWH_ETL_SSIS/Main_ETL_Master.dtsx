                      name="AccessMode"
                      typeConverter="AccessMode">2</property>
                    <property
                      dataType="System.String"
                      description="The mappings between the parameters in the SQL command and variables."
                      name="ParameterMapping"></property>
                  </properties>
                  <connections>
                    <connection
                      refId="Package\Container 02 - Load Dimensions\DF - Load DimCompetition\SRC - stg Competitions.Connections[OleDbConnection]"
                      connectionManagerID="Package.ConnectionManagers[MSI\\TRIEUHIEU.football_dwh_staging]"
                      connectionManagerRefId="Package.ConnectionManagers[MSI\\TRIEUHIEU.football_dwh_staging]"
                      description="The OLE DB runtime connection used to access the database."
                      name="OleDbConnection" />
                  </connections>
                  <outputs>
                    <output
                      refId="Package\Container 02 - Load Dimensions\DF - Load DimCompetition\SRC - stg Competitions.Outputs[OLE DB Source Output]"
                      name="OLE DB Source Output">
                      <outputColumns>
                        <outputColumn
                          refId="Package\Container 02 - Load Dimensions\DF - Load DimCompetition\SRC - stg Competitions.Outputs[OLE DB Source Output].Columns[competition_id]"
                          dataType="wstr"
                          errorOrTruncationOperation="Conversion"
                          errorRowDisposition="FailComponent"
                          externalMetadataColumnId="Package\Container 02 - Load Dimensions\DF - Load DimCompetition\SRC - stg Competitions.Outputs[OLE DB Source Output].ExternalColumns[competition_id]"
                          length="20"
                          lineageId="Package\Container 02 - Load Dimensions\DF - Load DimCompetition\SRC - stg Competitions.Outputs[OLE DB Source Output].Columns[competition_id]"
                          name="competition_id"
                          truncationRowDisposition="FailComponent" />
                        <outputColumn
                          refId="Package\Container 02 - Load Dimensions\DF - Load DimCompetition\SRC - stg Competitions.Outputs[OLE DB Source Output].Columns[competition_name]"
                          dataType="wstr"
                          errorOrTruncationOperation="Conversion"
