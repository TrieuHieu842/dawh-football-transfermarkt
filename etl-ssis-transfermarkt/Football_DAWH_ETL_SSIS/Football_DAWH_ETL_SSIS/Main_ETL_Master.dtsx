                  <outputs>
                    <output
                      refId="Package\Container 03 - Load Facts\DF - Load FactTeamMatch\SRC - stg Club Games.Outputs[OLE DB Source Output]"
                      name="OLE DB Source Output">
                      <outputColumns>
                        <outputColumn
                          refId="Package\Container 03 - Load Facts\DF - Load FactTeamMatch\SRC - stg Club Games.Outputs[OLE DB Source Output].Columns[game_id]"
                          dataType="i4"
                          errorOrTruncationOperation="Conversion"
                          errorRowDisposition="FailComponent"
                          externalMetadataColumnId="Package\Container 03 - Load Facts\DF - Load FactTeamMatch\SRC - stg Club Games.Outputs[OLE DB Source Output].ExternalColumns[game_id]"
                          lineageId="Package\Container 03 - Load Facts\DF - Load FactTeamMatch\SRC - stg Club Games.Outputs[OLE DB Source Output].Columns[game_id]"
                          name="game_id"
                          truncationRowDisposition="FailComponent" />
                        <outputColumn
                          refId="Package\Container 03 - Load Facts\DF - Load FactTeamMatch\SRC - stg Club Games.Outputs[OLE DB Source Output].Columns[club_id]"
                          dataType="i4"
                          errorOrTruncationOperation="Conversion"
                          errorRowDisposition="FailComponent"
                          externalMetadataColumnId="Package\Container 03 - Load Facts\DF - Load FactTeamMatch\SRC - stg Club Games.Outputs[OLE DB Source Output].ExternalColumns[club_id]"
                          lineageId="Package\Container 03 - Load Facts\DF - Load FactTeamMatch\SRC - stg Club Games.Outputs[OLE DB Source Output].Columns[club_id]"
                          name="club_id"
                          truncationRowDisposition="FailComponent" />
                        <outputColumn
                          refId="Package\Container 03 - Load Facts\DF - Load FactTeamMatch\SRC - stg Club Games.Outputs[OLE DB Source Output].Columns[opponent_id]"
                          dataType="i4"
                          errorOrTruncationOperation="Conversion"
